# Safe local-development defaults for postgres.compose.yml.
POSTGRES_DB=nexora_db
POSTGRES_USER=nexora_user
POSTGRES_PASSWORD=nexora_password

# Matching host-side backend environment values:
# NEXORA_DB_URL=jdbc:postgresql://localhost:5432/nexora_db
# NEXORA_DB_USERNAME=nexora_user
# NEXORA_DB_PASSWORD=nexora_password
