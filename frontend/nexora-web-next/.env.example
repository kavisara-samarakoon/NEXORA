# Local direct API mode. Copy to .env.local for local development only.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local same-origin proxy: replace the API base above with / and set:
# NEXORA_API_BASE_URL=http://localhost:8080

# Vercel: set ALL THREE in the project environment, replacing local values.
# NEXT_PUBLIC_API_BASE_URL=/
# NEXORA_API_BASE_URL=https://<render-backend-host>
# NEXT_PUBLIC_SITE_URL=https://<vercel-frontend-host>
# Browser calls use /api on Vercel. Only the server targets Render.
# Origins must have no /api, credentials, query or fragment; never proxy to Vercel itself.
# Rebuild/redeploy after changes. Keep NEXORA_API_BASE_URL available at runtime.
# NEXT_PUBLIC_* values are public: never put secrets or database settings here.
