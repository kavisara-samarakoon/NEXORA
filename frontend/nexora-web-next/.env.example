# v0.91 hosted configuration template; blank origins must be filled before use.
# Do not place secrets in this file or commit a filled environment file.
# NEXT_PUBLIC_* values are browser-visible. Never add credentials or database settings.
# / keeps browser /api/** requests on the frontend origin through Next.js.
NEXT_PUBLIC_API_BASE_URL=/
# Set the actual canonical frontend HTTPS origin in the hosting environment.
NEXT_PUBLIC_SITE_URL=

# Server-side only: the Next.js rewrite target and server-rendered API base.
# Set the backend HTTPS origin without /api, other paths, credentials, query or fragment.
# Never point this at the frontend or an alias that routes back to the frontend.
NEXORA_API_BASE_URL=

# Set all three before building; rebuild/redeploy after routing/site changes.
# Keep NEXORA_API_BASE_URL available at runtime. / without a backend target fails startup/build.
# For local proxy mode in an ignored .env.local, retain / and fill the origins with:
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXORA_API_BASE_URL=http://localhost:8080
# HTTP backend origins are allowed only for local development.
# For local direct mode instead, use NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# and leave NEXORA_API_BASE_URL unset.
