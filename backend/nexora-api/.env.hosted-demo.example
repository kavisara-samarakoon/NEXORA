# PLACEHOLDERS ONLY. Spring Boot does not load this file automatically.
# Copy variable names and your real values into Render's environment settings.
# Keep credentials in the provider's secret store; never commit a filled copy.
SPRING_PROFILES_ACTIVE=hosted-demo
# Render supplies PORT (normally 10000); keep it available at runtime.
PORT=10000

# Neon DIRECT hostname (no -pooler), JDBC scheme, credentials kept separate.
# In the Render UI, enter the URL value without surrounding quotes.
NEXORA_DB_URL="jdbc:postgresql://<neon-direct-host>:5432/<database>?sslmode=require&channelBinding=require"
NEXORA_DB_USERNAME=<database-role>
NEXORA_DB_PASSWORD=<neon-password-at-least-16-bytes>
NEXORA_JWT_SECRET=<independently-generated-secret-at-least-48-bytes>
NEXORA_REFRESH_TOKEN_HASH_SECRET=<different-generated-secret-at-least-48-bytes>
NEXORA_AUTH_TRUSTED_ORIGINS=https://<vercel-frontend-host>

# Same-origin Vercel /api routing keeps the existing Lax cookie topology.
NEXORA_REFRESH_TOKEN_COOKIE_SAME_SITE=Lax
NEXORA_AUTH_CSRF_COOKIE_SAME_SITE=Lax
# hosted-demo enforces Secure=true, CSRF enabled and /api/auth cookie paths.
# Keep optional Gemini/email/price-refresh providers at their existing defaults.
